{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug TS (tsx)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-r", "tsx/register", "--inspect"],
      "program": "${workspaceFolder}/src/app.ts",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "env": { "NODE_ENV": "development" }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug JS (dist)",
      "program": "${workspaceFolder}/dist/app.js",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    }
  ]
}